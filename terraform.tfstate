            "protected_settings": null,
            "protected_settings_from_key_vault": [],
            "provision_after_extensions": [],
            "publisher": "Microsoft.Azure.Extensions",
            "settings": "{\"commandToExecute\":\"mkdir -p /app \\u0026\\u0026 echo 'from flask import Flask\\napp = Flask(__name__)\\n@app.route(\\\"/\\\")\\ndef home():\\n    return \\\"Book Review App Tier is up and running on port 5000!\\\"\\nif __name__ == \\\"__main__\\\":\\n    app.run(host=\\\"0.0.0.0\\\", port=5000)' \\u003e /app/app.py \\u0026\\u0026 apt-get update -y \\u0026\\u0026 apt-get install -y python3-flask \\u0026\\u0026 echo '[Unit]\\nDescription=Flask Application\\nAfter=network.target\\n[Service]\\nUser=root\\nWorkingDirectory=/app\\nExecStart=/usr/bin/python3 /app/app.py\\nRestart=always\\n[Install]\\nWantedBy=multi-user.target' \\u003e /etc/systemd/system/flaskapp.service \\u0026\\u0026 systemctl daemon-reload \\u0026\\u0026 systemctl enable flaskapp \\u0026\\u0026 systemctl restart flaskapp\"}",
            "tags": {},
            "timeouts": null,
